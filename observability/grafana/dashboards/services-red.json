{
  "title": "Services - RED (Rate / Errors / Duration)",
  "uid": "services-red",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "monitoring-demo"
  ],
  "templating": {
    "list": [
      {
        "name": "application",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "query": "label_values(http_server_requests_milliseconds_count, application)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Request rate theo service (req/s)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (application) (rate(http_server_requests_milliseconds_count{application=~\"$application\"}[5m]))",
          "legendFormat": "{{application}}",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Error rate theo service (%)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (application) (rate(http_server_requests_milliseconds_count{application=~\"$application\",outcome=\"SERVER_ERROR\"}[5m])) / sum by (application) (rate(http_server_requests_milliseconds_count{application=~\"$application\"}[5m]))",
          "legendFormat": "{{application}}",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Latency p50 theo service",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (application, le) (rate(http_server_requests_milliseconds_bucket{application=~\"$application\"}[5m])))",
          "legendFormat": "{{application}}",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Latency p95 theo service",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (application, le) (rate(http_server_requests_milliseconds_bucket{application=~\"$application\"}[5m])))",
          "legendFormat": "{{application}}",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "Latency p99 theo service",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (application, le) (rate(http_server_requests_milliseconds_bucket{application=~\"$application\"}[5m])))",
          "legendFormat": "{{application}}",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          }
        }
      ]
    }
  ]
}
